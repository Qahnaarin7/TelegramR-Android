+/*
+ * TelegramR modifications to Telegram for Android.
+ * Licensed under GNU GPL v. 2 or later. See LICENSE.
+ */
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+public final class TelegramRSettings {
+    public static final int USE_ACCOUNT_DEFAULT = 0;
+    public static final int SEND_SILENTLY = 1;
+    public static final int KEEP_STANDARD_SENDING = 2;
+
+    private static final String SILENT_SEND = "silentSend";
+
+    public enum Privacy {
+        GHOST("ghostMode", false),
+        ONLINE("hideOnline", true),
+        READ("hideRead", true),
+        TYPING("hideTyping", true);
+
+        final String key;
+        final boolean defaultValue;
+
+        Privacy(String key, boolean defaultValue) {
+            this.key = key;
+            this.defaultValue = defaultValue;
+        }
+    }
+
+    private TelegramRSettings() {}
+
+    public static boolean getPrivacy(int account, Privacy privacy) {
+        return preferences(account).getBoolean(privacy.key, privacy.defaultValue);
+    }
+
+    public static void togglePrivacy(int account, Privacy privacy) {
+        preferences(account).edit().putBoolean(privacy.key, !getPrivacy(account, privacy)).apply();
+    }
+
+    public static boolean hideActivity(int account, Privacy privacy) {
+        return getPrivacy(account, Privacy.GHOST) && getPrivacy(account, privacy);
+    }
+
+    private static SharedPreferences preferences(int account) {
+        final long userId = UserConfig.getInstance(account).getClientUserId();
+        return ApplicationLoader.applicationContext.getSharedPreferences(
+                "telegramr_account_" + userId, Context.MODE_PRIVATE);
+    }
+
+    public static boolean hideChannelBar(int account, long dialogId) {
+        return preferences(account).getBoolean("channelBarHidden_" + dialogId, false);
+    }
+
+    public static void toggleChannelBar(int account, long dialogId) {
+        preferences(account).edit().putBoolean("channelBarHidden_" + dialogId, !hideChannelBar(account, dialogId)).apply();
+    }
+
+    public static int dialogScale() {
+        return Math.max(-2, Math.min(2, MessagesController.getGlobalMainSettings().getInt("telegramrDialogScale", 0)));
+    }
+
+    public static void setDialogScale(int size) {
+        MessagesController.getGlobalMainSettings().edit().putInt("telegramrDialogScale", size).apply();
+    }
+
+    public static boolean option(int account, String key) {
+        return preferences(account).getBoolean(key, false);
+    }
+
+    public static void toggleOption(int account, String key) {
+        preferences(account).edit().putBoolean(key, !option(account, key)).apply();
+    }
+
+    public static final String DELAY = "delayText";
+    public static final String READ_AFTER_SEND = "readAfterSend";
+    public static final String OBSERVED = "observedActivity";
+    public static final String HIDE_STORIES = "hideStoriesHeader";
+    public static final String HISTORY = "messageHistory";
+
+    public static void saveOwnActivity(int account, int time) {
+        if (time > ownActivity(account)) {
+            preferences(account).edit().putInt("ownActivity", time).apply();
+        }
+    }
+
+    public static int ownActivity(int account) {
+        return preferences(account).getInt("ownActivity", 0);
+    }
+
+    public static boolean isSilentSendEnabled(int account) {
+        return preferences(account).getBoolean(SILENT_SEND, false);
+    }
+
+    public static void setSilentSendEnabled(int account, boolean enabled) {
+        preferences(account).edit().putBoolean(SILENT_SEND, enabled).apply();
+    }
+
+    public static int getSilentSendOverride(int account, long dialogId) {
+        return preferences(account).getInt(SILENT_SEND + "_" + dialogId, USE_ACCOUNT_DEFAULT);
+    }
+
+    public static void setSilentSendOverride(int account, long dialogId, int choice) {
+        final SharedPreferences.Editor editor = preferences(account).edit();
+        final String key = SILENT_SEND + "_" + dialogId;
+        if (choice == USE_ACCOUNT_DEFAULT) {
+            editor.remove(key);
+        } else {
+            editor.putInt(key, choice);
+        }
+        editor.apply();
+    }
+
+    public static boolean shouldSendSilently(int account, long dialogId) {
+        if (dialogId == 0 || DialogObject.isEncryptedDialog(dialogId)) {
+            return false;
+        }
+        final int override = getSilentSendOverride(account, dialogId);
+        return override == SEND_SILENTLY
+                || (override == USE_ACCOUNT_DEFAULT && isSilentSendEnabled(account));
+    }
+}
