@@ -4,6 +4,20 @@ apply plugin: 'com.android.library'
 apply plugin: 'org.telegram.build-plugin'
 apply plugin: 'idea'
 
+def telegramrAbis = providers.gradleProperty('telegramrAbis').orNull
+
+def telegramrApi = new Properties()
+def telegramrApiFile = rootProject.file('.telegramr/api.properties')
+if (telegramrApiFile.isFile()) {
+    telegramrApiFile.withInputStream { telegramrApi.load(it) }
+}
+def telegramrApiId = telegramrApi.getProperty('apiId', '0')
+def telegramrApiHash = telegramrApi.getProperty('apiHash', '')
+if (telegramrApiFile.isFile() && (!(telegramrApiId ==~ /[1-9][0-9]{0,9}/) ||
+        !telegramrApiId.isInteger() || !(telegramrApiHash ==~ /[0-9a-fA-F]{32}/))) {
+    throw new GradleException('Set a positive apiId and a 32-character hexadecimal apiHash in .telegramr/api.properties.')
+}
+
