+/*
+ * TelegramR modifications to Telegram for Android.
+ * Licensed under GNU GPL v. 2 or later. See LICENSE.
+ */
+package org.telegram.ui;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.Rect;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+
+import androidx.core.content.ContextCompat;
+import androidx.core.util.Consumer;
+import androidx.core.view.ViewCompat;
+import androidx.core.view.WindowInsetsCompat;
+import androidx.window.java.layout.WindowInfoTrackerCallbackAdapter;
+import androidx.window.layout.DisplayFeature;
+import androidx.window.layout.FoldingFeature;
+import androidx.window.layout.WindowInfoTracker;
+import androidx.window.layout.WindowLayoutInfo;
+
+import org.telegram.messenger.AndroidUtilities;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Keeps the whole activity content inside one usable region in phone mode. */
+final class ChatPaneLayout extends FrameLayout {
+    private final Activity activity;
+    private final LayoutParams contentParams = new LayoutParams(
+            LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT, Gravity.TOP | Gravity.LEFT);
+    private final WindowInfoTrackerCallbackAdapter tracker;
+    private List<DisplayFeature> features = Collections.emptyList();
+    private final Consumer<WindowLayoutInfo> listener = info -> {
+        features = info.getDisplayFeatures();
+        requestLayout();
+    };
+
+    ChatPaneLayout(Activity activity, View content) {
+        super(activity);
+        this.activity = activity;
+        // Clear the unused region when a fold shrinks the active pane.
+        setBackgroundColor(Color.BLACK);
+        tracker = new WindowInfoTrackerCallbackAdapter(WindowInfoTracker.getOrCreate(activity));
+        addView(content, contentParams);
+        ViewCompat.setOnApplyWindowInsetsListener(this, (view, insets) -> {
+            if (contentParams.leftMargin == 0 && contentParams.topMargin == 0
+                    && contentParams.rightMargin == 0 && contentParams.bottomMargin == 0) {
+                return insets;
+            }
+            ViewCompat.dispatchApplyWindowInsets(content, insets.inset(
+                    contentParams.leftMargin, contentParams.topMargin,
+                    contentParams.rightMargin, contentParams.bottomMargin));
+            return WindowInsetsCompat.CONSUMED;
+        });
+    }
+
+    void startTracking() {
+        tracker.addWindowLayoutInfoListener(activity, ContextCompat.getMainExecutor(activity), listener);
+    }
+
+    void stopTracking() {
+        tracker.removeWindowLayoutInfoListener(listener);
+    }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        final int width = MeasureSpec.getSize(widthSpec);
+        final int height = MeasureSpec.getSize(heightSpec);
+        Rect area = new Rect(0, 0, width, height);
+        if (!AndroidUtilities.isTablet() && !features.isEmpty()) {
+            int[] origin = new int[2];
+            getLocationInWindow(origin);
+            area = selectArea(area, origin[0], origin[1], features);
+        }
+        final int rightMargin = width - area.right;
+        final int bottomMargin = height - area.bottom;
+        if (contentParams.leftMargin != area.left || contentParams.topMargin != area.top
+                || contentParams.rightMargin != rightMargin || contentParams.bottomMargin != bottomMargin) {
+            contentParams.setMargins(area.left, area.top, rightMargin, bottomMargin);
+            post(() -> ViewCompat.requestApplyInsets(this));
+        }
+        super.onMeasure(widthSpec, heightSpec);
+    }
+
+    private static Rect selectArea(Rect window, int offsetX, int offsetY, List<DisplayFeature> features) {
+        List<Rect> areas = new ArrayList<>();
+        areas.add(window);
+        for (DisplayFeature feature : features) {
+            if (!(feature instanceof FoldingFeature)) {
+                continue;
+            }
+            FoldingFeature fold = (FoldingFeature) feature;
+            if (!fold.isSeparating() && fold.getOcclusionType() != FoldingFeature.OcclusionType.FULL) {
+                continue;
+            }
+            Rect bounds = new Rect(fold.getBounds());
+            bounds.offset(-offsetX, -offsetY);
+            List<Rect> remaining = new ArrayList<>();
+            for (Rect area : areas) {
+                if (fold.getOrientation() == FoldingFeature.Orientation.VERTICAL
+                        && bounds.top <= area.top && bounds.bottom >= area.bottom
+                        && bounds.left < area.right && bounds.right > area.left) {
+                    addArea(remaining, area.left, area.top, bounds.left, area.bottom);
+                    addArea(remaining, bounds.right, area.top, area.right, area.bottom);
+                } else if (fold.getOrientation() == FoldingFeature.Orientation.HORIZONTAL
+                        && bounds.left <= area.left && bounds.right >= area.right
+                        && bounds.top < area.bottom && bounds.bottom > area.top) {
+                    addArea(remaining, area.left, area.top, area.right, bounds.top);
+                    addArea(remaining, area.left, bounds.bottom, area.right, area.bottom);
+                } else {
+                    remaining.add(area);
+                }
+            }
+            areas = remaining;
+        }
+        Rect largest = null;
+        long largestSize = 0;
+        for (Rect area : areas) {
+            long size = (long) area.width() * area.height();
+            if (size > largestSize) {
+                largest = area;
+                largestSize = size;
+            }
+        }
+        return largest != null ? largest : window;
+    }
+
+    private static void addArea(List<Rect> areas, int left, int top, int right, int bottom) {
+        if (right > left && bottom > top) {
+            areas.add(new Rect(left, top, right, bottom));
+        }
+    }
+}
