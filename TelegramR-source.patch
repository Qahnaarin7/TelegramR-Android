+    private static boolean sameTelegramRMedia(TLRPC.Message before, TLRPC.Message after) {
+        TLRPC.Document oldDocument = MessageObject.getDocument(before);
+        TLRPC.Document newDocument = MessageObject.getDocument(after);
+        if (oldDocument != null || newDocument != null) {
+            return oldDocument != null && newDocument != null && oldDocument.id == newDocument.id;
+        }
+        TLRPC.Photo oldPhoto = MessageObject.getPhoto(before);
+        TLRPC.Photo newPhoto = MessageObject.getPhoto(after);
+        return oldPhoto == null ? newPhoto == null : newPhoto != null && oldPhoto.id == newPhoto.id;
+    }
