+    private TelegramRHistory() {}
+
+    private static AtomicFile file(long owner) {
+        return new AtomicFile(new File(ApplicationLoader.getFilesDirFixed(), "telegramr-history-" + owner));
+    }
+
+    private static SecretKey key(long owner) throws Exception {
+        String alias = "telegramr-history-" + owner;
+        KeyStore store = KeyStore.getInstance("AndroidKeyStore");
+        store.load(null);
+        SecretKey key = (SecretKey) store.getKey(alias, null);
+        if (key != null) {
+            return key;
+        }
+        KeyGenerator generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore");
+        generator.init(new KeyGenParameterSpec.Builder(alias,
+                KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
+                .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+                .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+                .build());
+        return generator.generateKey();
+    }
+
+    private static JSONArray read(long owner) throws Exception {
+        AtomicFile file = file(owner);
+        if (!file.getBaseFile().exists() && !new File(file.getBaseFile().getPath() + ".bak").exists()) {
+            return new JSONArray();
+        }
+        JSONObject wrapper = new JSONObject(new String(file.readFully(), StandardCharsets.UTF_8));
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.DECRYPT_MODE, key(owner), new GCMParameterSpec(128,
+                Base64.decode(wrapper.getString("iv"), Base64.NO_WRAP)));
+        return new JSONArray(new String(cipher.doFinal(Base64.decode(wrapper.getString("data"),
+                Base64.NO_WRAP)), StandardCharsets.UTF_8));
+    }
+
+    private static void write(long owner, JSONArray entries) throws Exception {
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.ENCRYPT_MODE, key(owner));
+        JSONObject wrapper = new JSONObject()
+                .put("iv", Base64.encodeToString(cipher.getIV(), Base64.NO_WRAP))
+                .put("data", Base64.encodeToString(cipher.doFinal(entries.toString()
+                        .getBytes(StandardCharsets.UTF_8)), Base64.NO_WRAP));
+        AtomicFile file = file(owner);
+        FileOutputStream stream = file.startWrite();
+        try {
+            stream.write(wrapper.toString().getBytes(StandardCharsets.UTF_8));
+            file.finishWrite(stream);
+        } catch (Exception error) {
+            file.failWrite(stream);
+            throw error;
+        }
+    }
+
+    private static File mediaDirectory(long owner) {
+        return new File(ApplicationLoader.getFilesDirFixed(), "telegramr-history-media-" + owner);
+    }
+
+    static void saveMedia(long owner, File source, JSONObject record, String mime) throws Exception {
+        record.put("mime", mime);
+        if (owner == 0 || source == null || !source.isFile() || source.length() == 0 || source.length() > 16L * 1024 * 1024) {
+            return;
+        }
+        File directory = mediaDirectory(owner);
+        if (!directory.isDirectory() && !directory.mkdirs()) {
+            return;
+        }
+        File[] files = directory.listFiles();
+        long total = 0;
+        if (files != null) {
+            for (File file : files) {
+                total += file.length();
+            }
+        }
+        if (total + source.length() > 128L * 1024 * 1024) {
+            return;
+        }
+        String name = UUID.randomUUID().toString();
+        File target = new File(directory, name);
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.ENCRYPT_MODE, key(owner));
+        try (FileInputStream input = new FileInputStream(source);
+             FileOutputStream output = new FileOutputStream(target)) {
+            output.write(cipher.getIV());
+            try (CipherOutputStream encrypted = new CipherOutputStream(output, cipher)) {
+                byte[] buffer = new byte[32768];
+                int count;
+                while ((count = input.read(buffer)) != -1) {
+                    encrypted.write(buffer, 0, count);
+                }
+            }
+            record.put("media", name);
+        } catch (Exception error) {
+            target.delete();
+            throw error;
+        }
+    }
+
+    public static File openMedia(long owner, JSONObject record) throws Exception {
+        String name = record.optString("media");
+        if (!name.matches("[0-9a-f-]{36}")) {
+            return null;
+        }
+        File directory = new File(ApplicationLoader.getFilesDirFixed(), "cache");
+        if (!directory.isDirectory() && !directory.mkdirs()) {
+            return null;
+        }
+        File target = File.createTempFile("telegramr-preview-", ".tmp", directory);
+        try (FileInputStream input = new FileInputStream(new File(mediaDirectory(owner), name))) {
+            byte[] iv = new byte[12];
+            new java.io.DataInputStream(input).readFully(iv);
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.DECRYPT_MODE, key(owner), new GCMParameterSpec(128, iv));
+            try (CipherInputStream decrypted = new CipherInputStream(input, cipher);
+                 FileOutputStream output = new FileOutputStream(target)) {
+                byte[] buffer = new byte[32768];
+                int count;
+                while ((count = decrypted.read(buffer)) != -1) {
+                    output.write(buffer, 0, count);
+                }
+            }
+            return target;
+        } catch (Exception error) {
+            target.delete();
+            throw error;
+        }
+    }
+
+    private static void cleanMedia(long owner, JSONArray entries) {
+        java.util.HashSet<String> keep = new java.util.HashSet<>();
+        for (int i = 0; i < entries.length(); i++) {
+            JSONObject entry = entries.optJSONObject(i);
+            if (entry != null) {
+                keep.add(entry.optString("media"));
+            }
+        }
+        File[] files = mediaDirectory(owner).listFiles();
+        if (files != null) {
+            for (File file : files) {
+                if (!keep.contains(file.getName())) {
+                    file.delete();
+                }
+            }
+        }
+    }
+
+    static void append(long owner, List<JSONObject> records) {
+        if (owner == 0 || records.isEmpty()) {
+            return;
+        }
+        try {
+            JSONArray entries = prune(read(owner));
+            for (JSONObject record : records) {
+                entries.put(record);
+            }
+            entries = prune(entries);
+            write(owner, entries);
+            cleanMedia(owner, entries);
+        } catch (Exception error) {
+            FileLog.e(error);
+        }
+    }
+
+    private static JSONArray prune(JSONArray entries) throws Exception {
+        JSONArray result = new JSONArray();
+        long cutoff = System.currentTimeMillis() - RETENTION;
+        for (int i = Math.max(0, entries.length() - LIMIT); i < entries.length(); i++) {
+            JSONObject entry = entries.getJSONObject(i);
+            if (entry.getLong("saved") >= cutoff) {
+                result.put(entry);
+            }
+        }
+        return result;
+    }
+
+    public static List<JSONObject> search(long owner, long dialogId, String query) throws Exception {
+        ArrayList<JSONObject> result = new ArrayList<>();
+        if (owner == 0) {
+            return result;
+        }
+        JSONArray stored = read(owner);
+        JSONArray entries = prune(stored);
+        if (stored.length() != entries.length()) {
+            write(owner, entries);
+            cleanMedia(owner, entries);
+        }
+        String needle = query.toLowerCase(Locale.ROOT);
+        for (int i = entries.length() - 1; i >= 0; i--) {
+            JSONObject entry = entries.getJSONObject(i);
+            if (entry.getLong("dialog") == dialogId
+                    && entry.getString("text").toLowerCase(Locale.ROOT).contains(needle)) {
+                result.add(entry);
+            }
+        }
+        return result;
+    }
+
+    public static void clear(long owner) {
+        if (owner != 0) {
+            file(owner).delete();
+            cleanMedia(owner, new JSONArray());
+        }
+    }
+}
