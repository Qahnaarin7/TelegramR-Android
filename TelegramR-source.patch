+ */
+package org.telegram.ui;
+
+import static org.telegram.messenger.LocaleController.getString;
+
+import android.content.Context;
+import android.view.View;
+
+import org.telegram.messenger.R;
+import org.telegram.messenger.TelegramRSettings;
+import org.telegram.ui.Components.RecyclerListView;
+import org.telegram.ui.Components.UItem;
+import org.telegram.ui.Components.UniversalAdapter;
+import org.telegram.ui.Components.UniversalFragment;
+
+import java.util.ArrayList;
+
+final class TelegramRSettingsActivity extends UniversalFragment {
+    private static final int SILENT_SEND = 1;
+    private static final int GHOST = 2;
+    private static final int HIDE_ONLINE = 3;
+    private static final int HIDE_READ = 4;
+    private static final int HIDE_TYPING = 5;
+    private static final int DELAY = 6;
+    private static final int OBSERVED = 7;
+    private static final int HIDE_STORIES = 10;
+    private static final int HISTORY = 11;
+    private static final int CLEAR_HISTORY = 12;
+    private static final int READ_AFTER_SEND = 13;
+
+    TelegramRSettingsActivity(int account) {
+        currentAccount = account;
+    }
+
+    @Override
+    protected boolean useSimpleActionBar() {
+        return true;
+    }
+
+    @Override
+    public View createView(Context context) {
+        setHasOwnBackground(true);
+        final View view = super.createView(context);
+        listView.setSections();
+        listView.setSectionsDrawBackground(true);
+        return view;
+    }
+
+    @Override
+    protected RecyclerListView getListViewForSimpleGlass() {
+        return listView;
+    }
+
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
+
+    @Override
+    protected CharSequence getTitle() {
+        return getString(R.string.TelegramRExtra);
+    }
+
+    @Override
+    protected void fillItems(ArrayList<UItem> items, UniversalAdapter adapter) {
+        items.add(UItem.asHeader(getString(R.string.TelegramRPrivacy)));
+        addPrivacy(items, GHOST, R.string.TelegramRGhost, R.string.TelegramRGhostDescription, TelegramRSettings.Privacy.GHOST);
+        addPrivacy(items, HIDE_ONLINE, R.string.TelegramRHideOnline, R.string.TelegramRHideOnlineDescription, TelegramRSettings.Privacy.ONLINE);
+        addPrivacy(items, HIDE_READ, R.string.TelegramRHideRead, R.string.TelegramRHideReadDescription, TelegramRSettings.Privacy.READ);
+        addPrivacy(items, HIDE_TYPING, R.string.TelegramRHideTyping, R.string.TelegramRHideTypingDescription, TelegramRSettings.Privacy.TYPING);
+        items.add(UItem.asCheck(OBSERVED, getString(R.string.TelegramRObserved)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.option(currentAccount, TelegramRSettings.OBSERVED)));
+        items.add(UItem.asShadow(getString(R.string.TelegramRObservedDescription)));
+        items.add(UItem.asHeader(getString(R.string.TelegramRSending)));
+        items.add(UItem.asCheck(DELAY, getString(R.string.TelegramRDelay)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.option(currentAccount, TelegramRSettings.DELAY)));
+        items.add(UItem.asShadow(getString(R.string.TelegramRDelayDescription)));
+        items.add(UItem.asCheck(READ_AFTER_SEND, getString(R.string.TelegramRReadAfterSend)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.option(currentAccount, TelegramRSettings.READ_AFTER_SEND)));
+        items.add(UItem.asShadow(getString(R.string.TelegramRReadAfterSendDescription)));
+        items.add(UItem.asCheck(SILENT_SEND, getString(R.string.TelegramRSilentSend)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.isSilentSendEnabled(currentAccount)));
+        items.add(UItem.asShadow(getString(R.string.TelegramRSilentSendDescription)));
+        items.add(UItem.asCheck(HISTORY, getString(R.string.TelegramRHistory)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.option(currentAccount, TelegramRSettings.HISTORY)));
+        items.add(UItem.asShadow(getString(R.string.TelegramRHistoryDescription)));
+        items.add(UItem.asButton(CLEAR_HISTORY, getString(R.string.TelegramRClearHistory)));
+        items.add(UItem.asHeader(getString(R.string.TelegramRAppearance)));
+        items.add(UItem.asCheck(HIDE_STORIES, getString(R.string.TelegramRHideStories)).wrapCheckTitle()
+                .setChecked(TelegramRSettings.option(currentAccount, TelegramRSettings.HIDE_STORIES)));
+    }
+
+    private void addPrivacy(ArrayList<UItem> items, int id, int label, int description,
+                            TelegramRSettings.Privacy privacy) {
+        items.add(UItem.asCheck(id, getString(label)).wrapCheckTitle().setChecked(TelegramRSettings.getPrivacy(currentAccount, privacy)));
+        items.add(UItem.asShadow(getString(description)));
+    }
+
+    @Override
+    protected void onClick(UItem item, View view, int position, float x, float y) {
+        if (item.id == CLEAR_HISTORY) {
+            final long owner = getUserConfig().getClientUserId();
+            showDialog(new org.telegram.ui.ActionBar.AlertDialog.Builder(getParentActivity(), getResourceProvider())
+                    .setTitle(getString(R.string.TelegramRClearHistory))
+                    .setMessage(getString(R.string.TelegramRClearHistoryConfirm))
+                    .setNegativeButton(getString(R.string.Cancel), null)
+                    .setPositiveButton(getString(R.string.Delete), (dialog, which) ->
+                            getMessagesStorage().getStorageQueue().postRunnable(() ->
+                                    {
+                                        org.telegram.messenger.TelegramRHistory.clear(owner);
+                                        org.telegram.messenger.AndroidUtilities.runOnUIThread(() ->
+                                                getNotificationCenter().postNotificationName(
+                                                        org.telegram.messenger.NotificationCenter.telegramRHistoryUpdated));
+                                    }))
+                    .create());
+            return;
+        } else if (item.id == HISTORY) {
+            TelegramRSettings.toggleOption(currentAccount, TelegramRSettings.HISTORY);
+        } else if (item.id == HIDE_STORIES) {
+            TelegramRSettings.toggleOption(currentAccount, TelegramRSettings.HIDE_STORIES);
+        } else if (item.id == READ_AFTER_SEND) {
+            TelegramRSettings.toggleOption(currentAccount, TelegramRSettings.READ_AFTER_SEND);
+        } else if (item.id == DELAY || item.id == OBSERVED) {
+            TelegramRSettings.toggleOption(currentAccount, item.id == DELAY ? TelegramRSettings.DELAY : TelegramRSettings.OBSERVED);
+        } else if (item.id == SILENT_SEND) {
+            TelegramRSettings.setSilentSendEnabled(currentAccount,
+                    !TelegramRSettings.isSilentSendEnabled(currentAccount));
+        } else {
+            TelegramRSettings.Privacy privacy;
+            switch (item.id) {
+                case GHOST: privacy = TelegramRSettings.Privacy.GHOST; break;
+                case HIDE_ONLINE: privacy = TelegramRSettings.Privacy.ONLINE; break;
+                case HIDE_READ: privacy = TelegramRSettings.Privacy.READ; break;
+                case HIDE_TYPING: privacy = TelegramRSettings.Privacy.TYPING; break;
+                default: return;
+            }
+            TelegramRSettings.togglePrivacy(currentAccount, privacy);
+        }
+        listView.adapter.update(true);
+    }
+
+    @Override
+    protected boolean onLongClick(UItem item, View view, int position, float x, float y) {
+        return false;
+    }
+}
