+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.MessageDrawable;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Components.AvatarDrawable;
+import org.telegram.ui.Cells.ChatMessageCell;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.function.Consumer;
+
+/** Local archive annotations. Telegram's adapter, message IDs and unread counters stay intact. */
+final class TelegramRHistoryDecoration extends RecyclerView.ItemDecoration {
+    private final RecyclerView list;
+    private final int account;
+    private final Theme.ResourcesProvider theme;
+    private final MessageDrawable deletedBubble;
+    private final AvatarDrawable avatar = new AvatarDrawable();
+    private final LongSparseArray<ImageReceiver> avatars = new LongSparseArray<>();
+    private final Consumer<JSONObject> openMedia;
+    private final int slop;
+    private final SparseArray<List<JSONObject>> edits = new SparseArray<>();
+    private final SparseArray<List<JSONObject>> deletions = new SparseArray<>();
+    private final SparseArray<List<JSONObject>> trailingDeletions = new SparseArray<>();
+    private final SparseBooleanArray expanded = new SparseBooleanArray();
+    private final ArrayList<Hit> hits = new ArrayList<>();
+    private final TextPaint body = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final TextPaint marker = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final java.util.Map<JSONObject, StaticLayout> layouts = new java.util.IdentityHashMap<>();
+    private final TextPaint authorPaint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final java.util.Map<JSONObject, String> names = new java.util.IdentityHashMap<>();
+    private long dialogId;
+    private Hit pressed;
+    private boolean handlingTouch;
+    private float downX, downY;
+
+    private static final class Hit {
+        final RectF bounds;
+        final int editId;
+        final JSONObject media;
+
+        Hit(RectF bounds, int editId, JSONObject media) {
+            this.bounds = bounds;
+            this.editId = editId;
+            this.media = media;
+        }
+    }
+
+    TelegramRHistoryDecoration(RecyclerView list, int account, Theme.ResourcesProvider theme, Consumer<JSONObject> openMedia) {
+        this.list = list;
+        this.account = account;
+        this.theme = theme;
+        deletedBubble = new MessageDrawable(MessageDrawable.TYPE_TEXT, false, false, theme);
+        deletedBubble.setDrawFullBubble(true);
+        this.openMedia = openMedia;
+        slop = ViewConfiguration.get(list.getContext()).getScaledTouchSlop();
+        body.setTextSize(dp(SharedConfig.fontSize));
+        authorPaint.setTextSize(dp(14));
+        authorPaint.setTypeface(Typeface.DEFAULT_BOLD);
+        marker.setTextSize(dp(12));
+        list.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+            @Override
+            public void onViewAttachedToWindow(View view) {}
+
+            @Override
+            public void onViewDetachedFromWindow(View view) {
+                clearAvatars();
+            }
+        });
+    }
+
+    // Own the gesture from DOWN so Telegram's message tap and long-press handlers
+    // cannot select the message under the archive controls.
+    boolean handleTouch(MotionEvent event) {
+        final int action = event.getActionMasked();
+        if (action == MotionEvent.ACTION_DOWN) {
+            downX = event.getX();
+            downY = event.getY();
+            pressed = findHit(downX, downY);
+            handlingTouch = pressed != null;
+            return handlingTouch;
+        }
+        if (!handlingTouch) {
+            return false;
+        }
+        if (action == MotionEvent.ACTION_MOVE && (Math.abs(event.getX() - downX) > slop
+                || Math.abs(event.getY() - downY) > slop) || action == MotionEvent.ACTION_POINTER_DOWN) {
+            pressed = null;
+        } else if (action == MotionEvent.ACTION_UP) {
+            Hit target = pressed;
+            Hit current = findHit(event.getX(), event.getY());
+            pressed = null;
+            handlingTouch = false;
+            if (target != null && current != null && target.editId == current.editId && target.media == current.media) {
+                if (target.media != null) {
+                    openMedia.accept(target.media);
+                } else {
+                    expanded.put(target.editId, !expanded.get(target.editId));
+                    refresh(list);
+                }
+            }
+        } else if (action == MotionEvent.ACTION_CANCEL) {
+            pressed = null;
+            handlingTouch = false;
+        }
+        return true;
+    }
+
+    private Hit findHit(float x, float y) {
+        for (Hit hit : hits) {
+            if (hit.bounds.contains(x, y)) {
+                return hit;
+            }
+        }
+        return null;
+    }
+
+    void bind(List<JSONObject> records, List<MessageObject> messages, long dialog, long thread, boolean newestLoaded, boolean oldestLoaded) {
+        if (dialogId != dialog) {
+            expanded.clear();
+        }
+        if (dialogId != dialog || records.isEmpty()) {
+            clearAvatars();
+        }
+        dialogId = dialog;
+        layouts.clear();
+        names.clear();
+        body.setTextSize(dp(SharedConfig.fontSize));
+        edits.clear();
+        deletions.clear();
+        trailingDeletions.clear();
+        hits.clear();
+        ArrayList<Integer> ids = new ArrayList<>();
+        for (MessageObject message : messages) {
+            if (message.getDialogId() == dialog && message.getId() > 0 && message.contentType == 0 && message.getGroupId() == 0) {
+                ids.add(message.getId());
+            }
+        }
+        Collections.sort(ids);
+        for (JSONObject record : records) {
+            int id = record.optInt("id");
+            if (id <= 0 || (thread != 0 && record.optLong("thread", Long.MIN_VALUE) != thread)) {
+                continue;
+            }
+            int position = Collections.binarySearch(ids, id);
+            if (record.optBoolean("deleted")) {
+                int next = -position - 1;
+                if (position < 0 && !ids.isEmpty()) {
+                    if (next < ids.size() && (next > 0 || oldestLoaded)) {
+                        add(deletions, ids.get(next), record);
+                    } else if (next == ids.size() && newestLoaded) {
+                        add(trailingDeletions, ids.get(next - 1), record);
+                    }
+                }
+            } else if (position >= 0) {
+                List<JSONObject> versions = edits.get(id);
+                if (versions == null || versions.size() < 8) {
+                    add(edits, id, record);
+                }
+            }
+        }
+        for (int i = 0; i < deletions.size(); i++) {
+            deletions.valueAt(i).sort((left, right) -> Integer.compare(left.optInt("id"), right.optInt("id")));
+        }
+    }
+
+    private static void add(SparseArray<List<JSONObject>> entries, int id, JSONObject record) {
+        List<JSONObject> list = entries.get(id);
+        if (list == null) {
+            list = new ArrayList<>();
+            entries.put(id, list);
+        }
+        list.add(record);
+    }
+
+    @Override
+    public void getItemOffsets(Rect offsets, View child, RecyclerView parent, RecyclerView.State state) {
+        MessageObject message = child instanceof ChatMessageCell ? ((ChatMessageCell) child).getMessageObject() : null;
+        if (message == null || message.getDialogId() != dialogId || message.getGroupId() != 0) {
+            return;
+        }
+        int id = message.getId();
+        int width = width(parent, (ChatMessageCell) child);
+        List<JSONObject> deleted = deletions.get(id);
+        if (deleted != null) {
+            for (JSONObject record : deleted) {
+                offsets.top += deletedHeight(record, width);
+            }
+        }
+        List<JSONObject> trailing = trailingDeletions.get(id);
+        if (trailing != null) {
+            for (JSONObject record : trailing) {
+                offsets.bottom += deletedHeight(record, width);
+            }
+        }
+    }
+
+    void refresh(RecyclerView list) {
+        for (int i = 0; i < list.getChildCount(); i++) {
+            if (list.getChildAt(i) instanceof ChatMessageCell) {
+                list.getChildAt(i).requestLayout();
+            }
+        }
+        list.invalidateItemDecorations();
+    }
+
+    int editHeight(ChatMessageCell cell) {
+        MessageObject message = cell.getMessageObject();
+        if (message == null || message.getDialogId() != dialogId || message.getGroupId() != 0) {
+            return 0;
+        }
+        List<JSONObject> versions = edits.get(message.getId());
+        if (versions == null) {
+            return 0;
+        }
+        int height = dp(25);
+        if (needsEditAuthor(cell, versions)) {
+            height += dp(15);
+        }
+        if (expanded.get(message.getId())) {
+            for (JSONObject record : versions) {
+                height += dp(9) + layout(record, editWidth(cell)).getHeight();
+            }
+        }
+        return height;
+    }
+
+    private boolean needsEditAuthor(ChatMessageCell cell, List<JSONObject> versions) {
+        return DialogObject.isChatDialog(dialogId) && !cell.isDrawNameLayout() && senderId(versions.get(0)) != 0;
+    }
+
+    private static int editWidth(ChatMessageCell cell) {
+        return Math.max(dp(22), cell.backgroundWidth - dp(33));
+    }
+
+    private static int width(RecyclerView list, ChatMessageCell cell) {
+        return Math.max(dp(70), Math.min(dp(360), list.getWidth() - dp(cell.needDrawAvatar() ? 89 : 41)));
+    }
+
+    private int deletedHeight(JSONObject record, int width) {
+        return dp(44) + layout(record, width).getHeight();
+    }
+
+    private StaticLayout layout(JSONObject record, int width) {
+        StaticLayout cached = layouts.get(record);
+        if (cached != null && cached.getWidth() == width) {
+            return cached;
+        }
+        String text = record.optString("text");
+        if (record.has("mime")) {
+            String media = getString(record.has("media") ? R.string.TelegramRHistoryOpenMedia : R.string.TelegramRHistoryMediaMissing);
+            text = text.isEmpty() ? media : text + "\n" + media;
+        }
+        StaticLayout result = StaticLayout.Builder.obtain(text, 0, text.length(), body, width)
+                .setAlignment(Layout.Alignment.ALIGN_NORMAL).setIncludePad(false).build();
+        layouts.put(record, result);
+        return result;
+    }
+
+    @Override
+    public void onDrawOver(Canvas canvas, RecyclerView list, RecyclerView.State state) {
+        hits.clear();
+        for (int i = 0; i < list.getChildCount(); i++) {
+            if (!(list.getChildAt(i) instanceof ChatMessageCell)) {
+                continue;
+            }
+            ChatMessageCell cell = (ChatMessageCell) list.getChildAt(i);
+            MessageObject message = cell.getMessageObject();
+            if (message == null || message.getDialogId() != dialogId || message.getGroupId() != 0) {
+                continue;
+            }
+            int id = message.getId();
+            int width = width(list, cell);
+            boolean withAvatar = cell.needDrawAvatar();
+            List<JSONObject> deleted = deletions.get(id);
+            if (deleted != null) {
+                float y = cell.getY();
+                for (int j = deleted.size() - 1; j >= 0; j--) {
+                    JSONObject record = deleted.get(j);
+                    y -= deletedHeight(record, width);
+                    drawDeleted(canvas, record, y, width, withAvatar);
+                }
+            }
+            if (cell.getTelegramRHistoryHeight() > 0 && edits.get(id) != null) {
+                drawEdits(canvas, cell, message, edits.get(id));
+            }
+            List<JSONObject> trailing = trailingDeletions.get(id);
+            if (trailing != null) {
+                float y = cell.getY() + cell.getHeight();
+                for (int j = trailing.size() - 1; j >= 0; j--) {
+                    JSONObject record = trailing.get(j);
+                    drawDeleted(canvas, record, y, width, withAvatar);
+                    y += deletedHeight(record, width);
+                }
+            }
+        }
+    }
+
+    private void setTextColors(boolean out) {
+        body.setColor(Theme.getColor(out ? Theme.key_chat_messageTextOut : Theme.key_chat_messageTextIn, theme));
+        marker.setColor(ColorUtils.setAlphaComponent(body.getColor(), 170));
+    }
+
+    private void drawEdits(Canvas canvas, ChatMessageCell cell, MessageObject message, List<JSONObject> versions) {
+        setTextColors(message.isOutOwner());
+        float x = cell.getX() + cell.getBackgroundDrawableLeft() + dp(message.isOutOwner() ? 11 : 14);
+        float y = cell.getY() + cell.getTelegramRHistoryTop();
+        int id = message.getId();
+        int width = editWidth(cell);
+        boolean open = expanded.get(id);
+        if (needsEditAuthor(cell, versions)) {
+            JSONObject version = versions.get(0);
+            drawAuthor(canvas, senderId(version), senderName(version), width, x, y + dp(11));
+            y += dp(15);
+        }
+        String arrow = open ? "▾" : "▸";
+        String label = arrow + " " + getString(R.string.TelegramRRevisions) + " " + versions.size();
+        if (marker.measureText(label) > width) {
+            label = arrow + " " + versions.size();
+        }
+        canvas.drawText(label, x, y + dp(13), marker);
+        hits.add(new Hit(new RectF(x - dp(8), y, x + width + dp(8), y + dp(23)), id, null));
+        if (open) {
+            y += dp(22);
+            for (JSONObject record : versions) {
+                StaticLayout version = layout(record, width);
+                drawRecord(canvas, record, version, x, y);
+                y += version.getHeight() + dp(9);
+            }
+        }
+    }
+
+    private long senderId(JSONObject record) {
+        return record.optLong("sender", DialogObject.isUserDialog(dialogId) ? dialogId : 0);
+    }
+
+    private String senderName(JSONObject record) {
+        String name = names.get(record);
+        if (name == null) {
+            name = record.optString("senderName");
+            if (name.isEmpty() && senderId(record) != 0) {
+                name = DialogObject.getName(account, senderId(record));
+            }
+            if (name.isEmpty()) {
+                name = getString(R.string.TelegramRHistoryUnknownAuthor);
+            }
+            names.put(record, name);
+        }
+        return name;
+    }
+
+    private void drawDeleted(Canvas canvas, JSONObject record, float y, int maxWidth, boolean withAvatar) {
+        setTextColors(false);
+        long sender = senderId(record);
+        String name = senderName(record);
+        String time = LocaleController.getInstance().getFormatterDay().format(record.optLong("date") * 1000);
+        String label = getString(R.string.TelegramRDeleted) + " · " + time;
+        StaticLayout layout = layout(record, maxWidth);
+        float bodyWidth = 0;
+        for (int i = 0; i < layout.getLineCount(); i++) {
+            bodyWidth = Math.max(bodyWidth, layout.getLineWidth(i));
+        }
+        int textWidth = Math.min(maxWidth, (int) Math.ceil(Math.max(marker.measureText(label), Math.max(bodyWidth, authorPaint.measureText(name)))));
+        float left = dp(withAvatar ? 51 : 3);
+        float x = left + dp(17);
+        int bottom = (int) y + deletedHeight(record, maxWidth) - dp(3);
+        deletedBubble.setBounds((int) left, (int) y, (int) x + textWidth + dp(10), bottom);
+        deletedBubble.setAlpha(183);
+        deletedBubble.draw(canvas);
+        if (withAvatar && sender != 0) {
+            drawAvatar(canvas, sender, name, bottom - dp(40));
+        }
+        drawAuthor(canvas, sender, name, textWidth, x, y + dp(17));
+        drawRecord(canvas, record, layout, x, y + dp(22), textWidth);
+        canvas.drawText(TextUtils.ellipsize(label, marker, textWidth, TextUtils.TruncateAt.END).toString(),
+                x, bottom - dp(5), marker);
+    }
+
+    private void drawAuthor(Canvas canvas, long sender, String name, int width, float x, float y) {
+        authorPaint.setColor(sender == 0 ? marker.getColor() : AvatarDrawable.getColorForId(sender));
+        canvas.drawText(TextUtils.ellipsize(name, authorPaint, width, TextUtils.TruncateAt.END).toString(),
+                x, y, authorPaint);
+    }
+
+    private void clearAvatars() {
+        for (int i = 0; i < avatars.size(); i++) {
+            avatars.valueAt(i).onDetachedFromWindow();
+            avatars.valueAt(i).clearImage();
+        }
+        avatars.clear();
+    }
+
+    private void drawAvatar(Canvas canvas, long sender, String name, int top) {
+        ImageReceiver receiver = avatars.get(sender);
+        int size = dp(40);
+        int left = dp(6);
+        if (receiver == null) {
+            TLObject peer = MessagesController.getInstance(account).getUserOrChat(sender);
+            if (peer != null) {
+                AvatarDrawable placeholder = new AvatarDrawable();
+                placeholder.setInfo(account, peer);
+                receiver = new ImageReceiver(list);
+                receiver.setCurrentAccount(account);
+                receiver.setRoundRadius(size / 2);
+                receiver.onAttachedToWindow();
+                receiver.setForUserOrChat(peer, placeholder);
+                avatars.put(sender, receiver);
+            }
+        }
+        if (receiver != null) {
+            receiver.setImageCoords(left, top, size, size);
+            receiver.draw(canvas);
+        } else {
+            avatar.setInfo(sender, name, null);
+            avatar.setBounds(left, top, left + size, top + size);
+            avatar.draw(canvas);
+        }
+    }
+
+    private void drawRecord(Canvas canvas, JSONObject record, StaticLayout layout, float x, float y) {
+        drawRecord(canvas, record, layout, x, y, layout.getWidth());
+    }
+
+    private void drawRecord(Canvas canvas, JSONObject record, StaticLayout layout, float x, float y, int hitWidth) {
+        canvas.save();
+        canvas.translate(x, y);
+        layout.draw(canvas);
+        canvas.restore();
+        if (record.has("media")) {
+            hits.add(new Hit(new RectF(x, y, x + hitWidth, y + layout.getHeight()), 0, record));
+        }
+    }
+}
