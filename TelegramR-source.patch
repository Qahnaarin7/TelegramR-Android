+    void archiveTelegramRMessages(long dialogId, ArrayList<Integer> ids, TLRPC.Message replacement, boolean deleted) {
+        if (!TelegramRSettings.option(currentAccount, TelegramRSettings.HISTORY)
+                || ids.isEmpty() || DialogObject.isEncryptedDialog(dialogId)) {
+            return;
+        }
+        ArrayList<org.json.JSONObject> records = new ArrayList<>();
+        for (int start = 0; start < ids.size(); start += 100) {
+            SQLiteCursor cursor = null;
+            try {
+                String mids = TextUtils.join(",", ids.subList(start, Math.min(start + 100, ids.size())));
+                String peer = dialogId == 0 ? " AND is_channel = 0" : " AND uid = " + dialogId;
+                cursor = database.queryFinalized("SELECT uid, data FROM messages_v2 WHERE mid IN(" + mids + ")" + peer);
+                while (cursor.next()) {
+                    long uid = cursor.longValue(0);
+                    if (DialogObject.isEncryptedDialog(uid)) {
+                        continue;
+                    }
+                    NativeByteBuffer data = cursor.byteBufferValue(1);
+                    if (data == null) {
+                        continue;
+                    }
+                    TLRPC.Message message;
+                    try {
+                        message = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                    } finally {
+                        data.reuse();
+                    }
+                    if (!(message instanceof TLRPC.TL_message) || message.out || message.noforwards
+                            || message.ttl_period != 0 || MessageObject.isSecretMedia(message) || (message.media != null && message.media.ttl_seconds != 0)) {
+                        continue;
+                    }
+                    final String text = message.message == null ? "" : message.message;
+                    final TLRPC.Document document = MessageObject.getDocument(message);
+                    final boolean photo = message.media instanceof TLRPC.TL_messageMediaPhoto;
+                    if (text.length() > 8192 || text.isEmpty() && !photo && document == null
+                            || replacement != null && TextUtils.equals(text, replacement.message)
+                            && sameTelegramRMedia(message, replacement)) {
+                        continue;
+                    }
+                    final TLRPC.Chat chat = uid < 0 ? getMessagesController().getChat(-uid) : null;
+                    if (chat != null && chat.noforwards) {
+                        continue;
+                    }
+                    final long thread = ChatObject.isForum(chat)
+                            ? MessageObject.getTopicId(currentAccount, message, true)
+                            : message.reply_to == null ? 0 : message.reply_to.reply_to_top_id;
+                    org.json.JSONObject record = new org.json.JSONObject().put("dialog", uid).put("id", message.id)
+                            .put("thread", thread).put("date", message.date)
+                            .put("saved", System.currentTimeMillis()).put("deleted", deleted).put("text", text);
+                    long sender = DialogObject.getPeerDialogId(message.from_id);
+                    if (sender == 0 && (DialogObject.isUserDialog(uid) || message.post)) {
+                        sender = uid;
+                    }
+                    if (sender != 0) {
+                        String senderName = DialogObject.getName(currentAccount, sender);
+                        if (senderName.isEmpty()) {
+                            senderName = DialogObject.getName(sender > 0 ? getUser(sender) : getChat(-sender));
+                        }
+                        record.put("sender", sender).put("senderName", senderName);
+                    }
+                    if (!TextUtils.isEmpty(message.post_author)) {
+                        record.put("senderName", message.post_author);
+                    }
+                    if (photo || document != null) {
+                        try {
+                            if (document != null && (MessageObject.isVoiceDocument(document)
+                                    || MessageObject.isMusicDocument(document))) {
+                                org.telegram.tgnet.SerializedData serialized = new org.telegram.tgnet.SerializedData();
+                                try {
+                                    document.serializeToStream(serialized);
+                                    record.put("audio", android.util.Base64.encodeToString(
+                                            serialized.toByteArray(), android.util.Base64.NO_WRAP));
+                                } finally {
+                                    serialized.cleanup();
+                                }
+                            }
+                            TelegramRHistory.saveMedia(getUserConfig().getClientUserId(),
+                                    getFileLoader().getPathToMessage(message, false), record,
+                                    photo ? "image/jpeg" : document.mime_type == null ? "application/octet-stream" : document.mime_type);
+                        } catch (Exception error) {
+                            FileLog.e(error);
+                        }
+                    }
+                    records.add(record);
+                }
+            } catch (Exception error) {
+                FileLog.e(error);
+            } finally {
+                if (cursor != null) {
+                    cursor.dispose();
+                }
+            }
+        }
+        if (!records.isEmpty()) {
+            TelegramRHistory.append(getUserConfig().getClientUserId(), records);
+            AndroidUtilities.runOnUIThread(() ->
+                    getNotificationCenter().postNotificationName(NotificationCenter.telegramRHistoryUpdated));
+        }
+    }
